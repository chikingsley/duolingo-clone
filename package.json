    "@elysiajs/cors": "1.4.0",
    "@elysiajs/html": "1.4.0",
    "@elysiajs/static": "1.4.7",
    "@neondatabase/serverless": "^1.0.1",
    "@radix-ui/react-avatar": "^1.0.4",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-progress": "^1.0.3",
