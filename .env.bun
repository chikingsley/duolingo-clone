# Bun Environment Variables
NODE_ENV=development
PORT=3000

# Database (use your existing DATABASE_URL from .env)
# DATABASE_URL=postgresql://...

# Clerk (use your existing keys from .env)
# CLERK_SECRET_KEY=...
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=...

# Stripe (use your existing keys from .env)
# STRIPE_API_SECRET_KEY=...
# STRIPE_WEBHOOK_SECRET=...

# Admin IDs (use your existing from .env)
# CLERK_ADMIN_IDS=...

# App URL
APP_URL=http://localhost:3000
